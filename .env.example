# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string (local or cloud)
DATABASE_URL=postgresql://user:password@localhost:5432/multi_tenant_erp
# Example for Neon: postgresql://user:password@ep-xxx.aws.neon.tech/db?sslmode=require

# =============================================================================
# AUTHENTICATION
# =============================================================================
# JWT Secret - MUST be a strong, random string (64+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_64_CHARS_OR_MORE
# Token expiry time (15m, 1h, 1d, etc.)
JWT_EXPIRES_IN=7d

# =============================================================================
# REDIS
# =============================================================================
# Redis connection string (for caching, rate limiting, job queues)
REDIS_URL=redis://localhost:6379
# Example for Upstash: redis://default:password@xxx.upstash.io:6379

# =============================================================================
# STRIPE (PAYMENTS)
# =============================================================================
# Get from: https://dashboard.stripe.com/test/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
# Get from: https://dashboard.stripe.com/test/webhooks
# Create webhook endpoint: http://localhost:5000/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# Option 1: SMTP Server (recommended for production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# Option 2: Gmail (for development only)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Generate app password: https://myaccount.google.com/apppasswords

# Default sender email
EMAIL_FROM="Nexus ERP <notifications@yourdomain.com>"

# =============================================================================
# APPLICATION
# =============================================================================
# Server port
PORT=5000
# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5000
# Application URL (for email links)
APP_URL=http://localhost:5000
# Environment: development, production, test
NODE_ENV=development

# =============================================================================
# OPTIONAL: MONITORING
# =============================================================================
# Sentry DSN for error tracking (get from https://sentry.io)
# SENTRY_DSN=
